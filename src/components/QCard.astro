---
interface Props {
  number: string;
  title: string;
}
const { number, title } = Astro.props;
---

<details
  id={number}
  open
  class="qcard not-prose group my-3 scroll-mt-20 overflow-hidden rounded-xl border border-zinc-200 bg-zinc-50 shadow-sm transition-shadow duration-200 open:shadow-md dark:border-zinc-700 dark:bg-zinc-800"
>
  <summary
    class="flex w-full cursor-pointer list-none items-center gap-4 px-5 py-4 transition-colors duration-150 hover:bg-zinc-100 dark:hover:bg-zinc-700 [&::-webkit-details-marker]:hidden"
  >
    <span
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-teal-700 text-sm font-bold text-white"
      >{number}</span
    >
    <span class="flex-1 text-sm font-semibold text-zinc-800 dark:text-zinc-100 md:text-base"
      >{title}</span
    >
    <svg
      class="h-5 w-5 shrink-0 text-zinc-400 transition-transform duration-300 group-open:rotate-180 dark:text-zinc-500"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </summary>

  <div class="border-t border-zinc-200 px-5 pb-5 pt-4 dark:border-zinc-700">
    {/* Sliding tab bar */}
    <div class="qcard-tabs relative mb-4 inline-flex rounded-full bg-zinc-200/80 p-1 dark:bg-zinc-700/80" style="display: flex; width: fit-content; margin-left: auto; margin-right: auto;">
      {/* Sliding pill indicator */}
      <div
        class="qcard-slider pointer-events-none absolute bottom-1 left-1 top-1 rounded-full bg-white shadow-sm transition-transform duration-200 ease-in-out dark:bg-zinc-600"
        style="width: 0;"
      ></div>

      <button
        type="button"
        data-target="challenge"
        data-index="0"
        class="qcard-tab relative z-10 flex items-center justify-center gap-1 rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wide transition-colors duration-150 text-red-700 dark:text-amber-300"
        data-active="true"
      >
        <span class="dot inline-block h-1.5 w-1.5 rounded-full bg-red-400 dark:bg-amber-400"></span>
        Challenge
      </button>
      <button
        type="button"
        data-target="solution"
        data-index="1"
        class="qcard-tab relative z-10 flex items-center justify-center gap-1 rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wide transition-colors duration-150 text-zinc-500 dark:text-zinc-400"
        data-active="false"
      >
        <span class="dot inline-block h-1.5 w-1.5 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
        Solution
      </button>
      <button
        type="button"
        data-target="bottom-line"
        data-index="2"
        class="qcard-tab relative z-10 flex items-center justify-center gap-1 rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wide transition-colors duration-150 text-zinc-500 dark:text-zinc-400"
        data-active="false"
      >
        <span class="dot inline-block h-1.5 w-1.5 rounded-full bg-zinc-400 dark:bg-zinc-500"></span>
        Bottom Line
      </button>
    </div>

    {/* Step panels — only one visible at a time */}
    <div data-panel="challenge" class="qcard-panel rounded-lg border border-red-200 bg-red-50 p-4 dark:border-amber-500/50 dark:bg-amber-900/40">
      <div class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-red-700 dark:text-amber-300">
        <span class="inline-block h-2 w-2 rounded-full bg-red-400 dark:bg-amber-400"></span>
        Challenge
      </div>
      <div class="text-sm leading-relaxed text-zinc-800 dark:text-zinc-200 [&_p]:my-1 [&_ul]:my-1 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:my-0.5">
        <slot name="challenge" />
      </div>
    </div>

    <div data-panel="solution" class="qcard-panel hidden rounded-lg border border-blue-200 bg-blue-50 p-4 dark:border-sky-400/60 dark:bg-sky-800/50">
      <div class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-sky-200">
        <span class="inline-block h-2 w-2 rounded-full bg-blue-400 dark:bg-sky-400"></span>
        Solution
      </div>
      <div class="text-sm leading-relaxed text-zinc-800 dark:text-zinc-200 [&_p]:my-1 [&_ul]:my-1 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:my-0.5">
        <slot name="solution" />
      </div>
    </div>

    <div data-panel="bottom-line" class="qcard-panel hidden rounded-lg border border-teal-200 bg-teal-50 p-4 dark:border-emerald-500/50 dark:bg-emerald-900/40">
      <div class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-teal-700 dark:text-emerald-300">
        <span class="inline-block h-2 w-2 rounded-full bg-teal-500 dark:bg-emerald-400"></span>
        Bottom Line
      </div>
      <div class="text-sm leading-relaxed text-zinc-800 dark:text-zinc-200 [&_p]:my-1 [&_ul]:my-1 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:my-0.5">
        <slot name="bottom-line" />
      </div>
    </div>
  </div>
</details>

<script>
  type Key = "challenge" | "solution" | "bottom-line";

  const ACTIVE_TEXT: Record<Key, string> = {
    challenge: "text-red-700 dark:text-amber-300",
    solution: "text-blue-700 dark:text-sky-200",
    "bottom-line": "text-teal-700 dark:text-emerald-300",
  };

  const ACTIVE_DOT: Record<Key, string> = {
    challenge: "bg-red-400 dark:bg-amber-400",
    solution: "bg-blue-400 dark:bg-sky-300",
    "bottom-line": "bg-teal-500 dark:bg-emerald-400",
  };

  const INACTIVE_TEXT = "text-zinc-500 dark:text-zinc-400";
  const INACTIVE_DOT = "bg-zinc-400 dark:bg-zinc-500";

  function moveSlider(slider: HTMLElement, tab: HTMLButtonElement) {
    slider.style.width = `${tab.offsetWidth}px`;
    slider.style.transform = `translateX(${tab.offsetLeft - 4}px)`;
  }

  document.querySelectorAll<HTMLElement>(".qcard").forEach((card) => {
    const tabs = card.querySelectorAll<HTMLButtonElement>(".qcard-tab");
    const panels = card.querySelectorAll<HTMLElement>(".qcard-panel");
    const slider = card.querySelector<HTMLElement>(".qcard-slider");

    // Init slider on first active tab
    const firstActive = card.querySelector<HTMLButtonElement>(".qcard-tab[data-active='true']");
    if (slider && firstActive) moveSlider(slider, firstActive);

    tabs.forEach((tab) => {
      tab.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        const target = tab.dataset.target as Key;
        // Move slider to clicked tab
        if (slider) moveSlider(slider, tab);

        // Update tab text + dot colors
        tabs.forEach((t) => {
          const key = t.dataset.target as Key;
          const isActive = t === tab;
          const base =
            "qcard-tab relative z-10 flex items-center justify-center gap-1 rounded-full px-3.5 py-1 text-xs font-semibold uppercase tracking-wide transition-colors duration-150 ";
          t.className = base + (isActive ? ACTIVE_TEXT[key] : INACTIVE_TEXT);
          const dot = t.querySelector<HTMLElement>(".dot");
          if (dot) {
            dot.className =
              "dot inline-block h-1.5 w-1.5 rounded-full " +
              (isActive ? ACTIVE_DOT[key] : INACTIVE_DOT);
          }
        });

        // Show/hide panels
        panels.forEach((p) => {
          if (p.dataset.panel === target) p.classList.remove("hidden");
          else p.classList.add("hidden");
        });
      });
    });
  });
</script>
