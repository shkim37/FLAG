---
interface Props {
  id: string;
  src: ImageMetadata;
  detailSrc: ImageMetadata;
  alt: string;
}

const { id, src, detailSrc, alt } = Astro.props;
const dialogId = `${id}-dialog`;
---

<div class="result-zoom not-prose">
  <button
    type="button"
    class="group/zoom block w-full cursor-zoom-in rounded-lg border border-zinc-200 bg-white p-2 text-left shadow-sm transition hover:border-teal-400 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 dark:border-zinc-700 dark:bg-zinc-900/50"
    data-result-zoom-trigger={dialogId}
    aria-label="Open detailed figure with caption"
  >
    <img
      src={src.src}
      width={src.width}
      height={src.height}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="mx-auto h-auto max-w-full rounded-md object-contain transition-transform duration-200 group-hover/zoom:scale-[1.01]"
    />
    <div class="mt-1.5 flex items-center justify-center gap-1 text-[10px] select-none text-zinc-400 dark:text-zinc-500">
      <svg class="h-3 w-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" /><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35" />
      </svg>
      <span>Click to expand with caption</span>
    </div>
  </button>

  <dialog
    id={dialogId}
    class="result-zoom-dialog m-auto max-h-[90vh] w-[90vw] max-w-[90vw] rounded-xl border border-zinc-200 bg-white p-3 shadow-2xl backdrop:bg-zinc-950/75 dark:border-zinc-700 dark:bg-zinc-950"
    data-result-zoom-dialog
  >
    <div class="flex justify-end pb-2">
      <button
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-zinc-300 bg-white text-xl leading-none text-zinc-700 transition hover:bg-zinc-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800"
        data-result-zoom-close
        aria-label="Close detailed figure"
      >
        ×
      </button>
    </div>
    <img
      src={detailSrc.src}
      width={detailSrc.width}
      height={detailSrc.height}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="mx-auto max-h-[calc(90vh-4.75rem)] max-w-full rounded-lg object-contain"
    />
  </dialog>
</div>

<style is:global>
  .result-zoom-dialog[open] {
    animation: rzi-zoom-in 0.24s cubic-bezier(0.34, 1.4, 0.64, 1) both;
  }
  .result-zoom-dialog.rzi-closing {
    animation: rzi-zoom-out 0.18s cubic-bezier(0.4, 0, 1, 1) both;
  }
  @keyframes rzi-zoom-in {
    from { opacity: 0; transform: scale(0.86); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes rzi-zoom-out {
    from { opacity: 1; transform: scale(1); }
    to   { opacity: 0; transform: scale(0.86); }
  }
  .result-zoom-dialog[open]::backdrop {
    animation: rzi-backdrop-in 0.24s ease both;
  }
  .result-zoom-dialog.rzi-closing::backdrop {
    animation: rzi-backdrop-out 0.18s ease both;
  }
  @keyframes rzi-backdrop-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes rzi-backdrop-out {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
</style>

<script>
  const setupResultZoomImages = () => {
    const closeWithAnimation = (dialog: HTMLDialogElement) => {
      if (dialog.classList.contains("rzi-closing")) return;
      dialog.classList.add("rzi-closing");
      dialog.addEventListener(
        "animationend",
        () => {
          dialog.classList.remove("rzi-closing");
          dialog.close();
        },
        { once: true }
      );
    };

    document
      .querySelectorAll<HTMLButtonElement>("[data-result-zoom-trigger]")
      .forEach((trigger) => {
        if (trigger.dataset.resultZoomReady === "true") return;
        trigger.dataset.resultZoomReady = "true";

        const dialogId = trigger.dataset.resultZoomTrigger;
        const dialog = dialogId ? document.getElementById(dialogId) : null;
        if (!(dialog instanceof HTMLDialogElement)) return;

        trigger.addEventListener("click", () => dialog.showModal());
      });

    document
      .querySelectorAll<HTMLDialogElement>("[data-result-zoom-dialog]")
      .forEach((dialog) => {
        if (dialog.dataset.resultZoomReady === "true") return;
        dialog.dataset.resultZoomReady = "true";

        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) closeWithAnimation(dialog);
        });

        dialog.addEventListener("cancel", (event) => {
          event.preventDefault();
          closeWithAnimation(dialog);
        });

        dialog
          .querySelector<HTMLButtonElement>("[data-result-zoom-close]")
          ?.addEventListener("click", () => closeWithAnimation(dialog));
      });
  };

  setupResultZoomImages();
  document.addEventListener("astro:after-swap", setupResultZoomImages);
</script>
