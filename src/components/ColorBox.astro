---
interface Props {
  /** Base color (LaTeX `myteal`). */
  color?: string;
  /** Background mix percent toward white (`colback=myteal!10`). */
  backMix?: number;
  /** Frame and title bar mix percent (`colframe=myteal!95`). */
  frameMix?: number;
  /** Plain-text title; use the `title` slot for math or markdown. */
  title?: string;
}

const {
  color = "#0F766E",
  backMix = 10,
  frameMix = 95,
  title,
} = Astro.props;

const hasTitle = Boolean(title) || Astro.slots.has("title");
const frameColor = `color-mix(in srgb, ${color} ${frameMix}%, white)`;
const backColor = `color-mix(in srgb, ${color} ${backMix}%, white)`;
---

<div
  class="my-1 overflow-hidden rounded-[2mm] border-[0.8pt] text-zinc-900 dark:text-zinc-950 [&>:first-child]:mt-0 [&>:last-child]:mb-0 [&_a]:text-blue-800 [&_a]:hover:underline dark:[&_a]:text-blue-600 [&_strong]:!text-zinc-950 dark:[&_strong]:!text-zinc-950"
  style={{
    borderColor: frameColor,
    backgroundColor: backColor,
  }}
>
  {
    hasTitle && (
      <div
        class="px-4 py-[8pt] text-base font-bold text-white [&_strong]:text-white"
        style={{ backgroundColor: frameColor }}
      >
        {title ? title : <slot name="title" />}
      </div>
    )
  }
  <div class="px-[9pt] py-[5pt]">
    <slot />
  </div>
</div>
